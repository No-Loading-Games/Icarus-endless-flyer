    m_PersistentCalls:
      m_Calls: []
  m_text: '- <b>Obstacle Collision</b>: Now deducts stamina instead of causing an
    instant fall.


    - <b>Power-Up Costs</b>: Reduced upgrade prices for faster
    early-game progress; refunds issued for prior upgrades.


    - <b>Visual & UX</b>:
    Improved sprites and added indicators for better clarity.


    - <b>Tutorial</b>:
    Tutorial is updated and now replayable through the Tutorial Button [''?''] in
    Main Menu.


    - <b>Bug Fixes</b>: Artemis & Hermes Boots bugs fixed.


    -
    <b>Dash</b>: Player controller reworked to make the Dash more accurate.


    -
    <b>New Headwear</b>: Added the ''<b>Pumpkin of Hollow</b>'' Headwear for purchase
    in the Skins Shop.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ecc2078b36c8e0643b6cb55ede0f12cd, type: 2}
